# Fuzzy find npm scripts
#
# This will list all the npm scripts in the current project and allow you to fuzzy find and run them.
#
# Dependencies:
# - jq
# - fzf
#
# Usage:
#
# ```bash
# npmr
# ```

function npmr {
    jq -r \
        '.scripts | to_entries[] | "\(.key)\t\(.value)"' package.json | \
    fzf --with-nth=1 \
        --preview "echo {} | cut -f2" | \
    cut -f1 | \
    xargs -r npm run
}