#!/usr/bin/env zsh

# [g]it [b]ranch [f]ind – Show all git branches and checkout the selected one
#
# Dependencies:
# - fzf
# - git
#
# Usage:
#
# ```bash
# gbf
# ```
#

function gbf {
	local git_log_format="git log --graph --pretty=format:'%C(yellow)%ad%Creset %C(white)%s%Creset %C(bold yellow)%d%Creset %C(bold blue)<%an>%Creset' --color=always --date=short"
	local current_dir_name=$(basename "$PWD")
	echo -ne "\e]2;$current_dir_name: git branches \a"
	git for-each-ref \
		--color=always \
		--sort=-committerdate refs/heads/ \
		--format='%(color:yellow)%(committerdate:relative)%(color:reset) %09 %(color:reset)%(if)%(HEAD)%(then)%(color:green)%(end) %(HEAD) %(refname:short)' |
		fzf \
			--ansi \
			--header "$current_dir_name git branches | enter checkout branch, ctrl-o open preview, ctrl-g open on GitHub, ctrl-f preview down, ctrl-b preview up" \
			--bind "ctrl-f:preview-page-down,ctrl-b:preview-page-up" \
			--bind "ctrl-o:execute:$eval($git_log_format)" \
			--bind "ctrl-g:execute-silent:(
				branch=\$(echo {} | awk '{print \$NF}')
				remote_url=\$(git config --get remote.origin.url)
				repo_url=\$(echo \"\$remote_url\" | sed -E 's#^git@([^:]+):#https://\1/#; s#\.git\$##')
				open \"\$repo_url/tree/\$branch\"
			)" \
			--preview="$git_log_format -50 \$(echo {} | awk '{print \$NF}')" \
			--accept-nth="-1" |
		xargs git checkout
}
