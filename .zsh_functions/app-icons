#!/usr/bin/env zsh

# Script to generate all PWA assets from source images
# Source: app-icon.png (1024x1024) and app-icon.svg
set -e
cd /home/runner/work/layout-editor/layout-editor/static
echo "Generating PWA icons from app-icon.png..."
# Generate standard PWA icons
convert app-icon.png -resize 48x48 pwa-48.png
convert app-icon.png -resize 72x72 pwa-72.png
convert app-icon.png -resize 96x96 pwa-96.png
convert app-icon.png -resize 128x128 pwa-128.png
convert app-icon.png -resize 144x144 pwa-144.png
convert app-icon.png -resize 192x192 pwa-192.png
convert app-icon.png -resize 256x256 pwa-256.png
convert app-icon.png -resize 384x384 pwa-384.png
convert app-icon.png -resize 512x512 pwa-512.png
echo "Generating Apple Touch Icon..."
convert app-icon.png -resize 180x180 apple-touch-icon.png
echo "Generating maskable icons (with safe zone padding)..."
# Maskable icons need safe zone - create with 20% padding
# For 192x192, safe zone is about 38px from edge, so content should be centered 116x116
convert app-icon.png -resize 154x154 -gravity center -extent 192x192 -background transparent icon-maskable-192.png
convert app-icon.png -resize 410x410 -gravity center -extent 512x512 -background transparent icon-maskable-512.png
echo "Generating favicons..."
convert app-icon.png -resize 32x32 favicon-32x32.png
convert app-icon.png -resize 16x16 favicon-16x16.png
# Generate multi-resolution favicon.ico
convert app-icon.png -resize 16x16 -resize 32x32 favicon-16.png
convert app-icon.png -resize 32x32 favicon-32.png
convert favicon-16.png favicon-32.png -colors 256 favicon.ico
rm favicon-16.png favicon-32.png
echo "Generating social share images..."
# OpenGraph image (1200x630) - place icon in center with background
convert -size 1200x630 xc:"#18181b" \
        app-icon.png -resize 512x512 \
        -gravity center -composite \
        og-image.png
# Twitter card (can be same as OG)
cp og-image.png twitter-card.png
echo "Generating iOS splash screen (iPhone X/11 Pro)..."
# Generate at least one iOS splash screen (1125x2436 for iPhone X/11 Pro)
convert -size 1125x2436 xc:"#18181b" \
        app-icon.png -resize 512x512 \
        -gravity center -composite \
        apple-splash-1125x2436.png
echo "All PWA assets generated successfully!"
ls -lh *.png *.ico | grep -E "(pwa-|apple-|icon-|favicon|og-|twitter-)" || true
